{
  "expo": {
    "name": "jNavi",
    "slug": "jNavi",
    "scheme": "jnavi",
    "version": "1.0.0",
    "owner": "syumeikyo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syumeikyo.jNavi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "このアプリでは、地図上で現在位置を表示するために位置情報を使用します。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.syumeikyo.jNavi",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "extra": {
      "eas": {
        "projectId": "830a1ac5-63d1-4f2a-bae3-70690b43e236"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow jNavi to use your location.",
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ]
  }
}

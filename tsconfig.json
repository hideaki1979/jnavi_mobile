{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    // TypeScript 7.0 で `baseUrl` は完全廃止(TS5102)、`paths` の値は相対パス必須
    // (TS5090)になった。TS5.0+ / TS7 は baseUrl 無しでも `paths` を tsconfig.json
    // からの相対で解決するため baseUrl を撤去。`@/` は Metro(Expo標準)が
    // この `paths` を読んでバンドラ側のエイリアスも解決する(baseUrl 撤去後も
    // `expo export` で `@/` 解決を確認済み)。未使用だった `~/*` は削除した。
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
